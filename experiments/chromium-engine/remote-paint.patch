+void VerifyRemoteFonts(bool outlines) {
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  auto environment = base::Environment::Create();
+  constexpr char variable[] = "VIRTUAL_DESKTOP_REMOTE_FONT_DIRECTORY";
+  auto previous = environment->GetVar(variable);
+  auto previous_outlines = environment->GetVar("VIRTUAL_DESKTOP_TEST_OUTLINE_FONTS");
+  environment->SetVar("VIRTUAL_DESKTOP_TEST_OUTLINE_FONTS", outlines ? "1" : "0");
+  struct Restore {
+    raw_ptr<base::Environment> environment;
+    std::optional<std::string> previous;
+    std::optional<std::string> previous_outlines;
+    ~Restore() {
+      if (previous_outlines) environment->SetVar("VIRTUAL_DESKTOP_TEST_OUTLINE_FONTS", *previous_outlines);
+      else environment->UnSetVar("VIRTUAL_DESKTOP_TEST_OUTLINE_FONTS");
+      if (previous) environment->SetVar("VIRTUAL_DESKTOP_REMOTE_FONT_DIRECTORY", *previous);
+      else environment->UnSetVar("VIRTUAL_DESKTOP_REMOTE_FONT_DIRECTORY");
+    }
+  } restore{environment.get(), previous, previous_outlines};
+  auto list = base::MakeRefCounted<DisplayItemList>();
+  list->StartPaint();
+  list->push<DrawTextBlobOp>(SkTextBlob::MakeFromString("Remote font", skia::DefaultFont()),
+                            0.0f, 20.0f, PaintFlags());
+  list->EndPaintOfUnpaired(gfx::Rect(0, 0, 200, 40));
+  list->Finalize();
+  auto snapshot = [&]() {
+    std::string json;
+    list->CreateTracedValueForRemotePaint()->AppendAsTraceFormat(&json);
+    return base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  };
+  environment->UnSetVar(variable);
+  auto missing = snapshot();
+  ASSERT_TRUE(missing);
+  EXPECT_TRUE(missing->GetDict().FindBool("font_error").value_or(false));
+  EXPECT_FALSE(missing->GetDict().FindString("skp64"));
+  environment->SetVar(variable, directory.GetPath().value());
+  auto first = snapshot();
+  ASSERT_TRUE(first);
+  EXPECT_FALSE(first->GetDict().FindBool("font_error").value_or(true));
+  const auto* fonts = first->GetDict().FindList("fonts");
+  ASSERT_TRUE(fonts);
+  ASSERT_EQ(1u, fonts->size());
+  const auto* id = (*fonts)[0].GetDict().FindString("id");
+  ASSERT_TRUE(id);
+  EXPECT_EQ(64u, id->size());
+  ASSERT_TRUE(DisplayItemList::WriteRemoteFontAssets());
+  std::string font_bytes;
+  ASSERT_TRUE(base::ReadFileToString(directory.GetPath().AppendASCII(*id + ".font"),
+                                   &font_bytes));
+  EXPECT_EQ(font_bytes.size(), (*fonts)[0].GetDict().FindInt("bytes").value_or(0));
+  if (outlines) EXPECT_EQ("vdglyph1", font_bytes.substr(0, 8));
+  const auto* encoded = first->GetDict().FindString("skp64");
+  ASSERT_TRUE(encoded);
+  std::string picture;
+  ASSERT_TRUE(base::Base64Decode(*encoded, &picture));
+  EXPECT_LT(picture.size(), 8192u);
+  EXPECT_NE(std::string::npos, picture.find("vdfont01"));
+  auto second = snapshot();
+  ASSERT_TRUE(second);
+  EXPECT_EQ(first->GetDict(), second->GetDict());
+}

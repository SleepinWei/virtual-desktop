+// Local experimental transport. Each renderer holds at most one in-progress
+// message and one newest pending message. Socket IO never runs on the impl
+// thread, and a slow consumer cannot create an unbounded task queue.
+class RemotePaintStream {
+ public:
+  RemotePaintStream() {
+    auto environment = base::Environment::Create();
+    auto path = environment->GetVar("VIRTUAL_DESKTOP_REMOTE_PAINT_SOCKET");
+    auto token = environment->GetVar("VIRTUAL_DESKTOP_REMOTE_PAINT_TOKEN");
+    if (!path || !token || path->empty() || path->front() != '/' ||
+        path->size() >= sizeof(sockaddr_un::sun_path) || token->size() != 64 ||
+        token->find_first_not_of("0123456789abcdef") != std::string::npos) {
+      return;
+    }
+    path_ = std::move(*path);
+    token_ = std::move(*token);
+    writer_ = base::ThreadPool::CreateSequencedTaskRunner(
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+  }
+
+  bool enabled() const { return !!writer_; }
+
+  void Submit(std::string snapshot) {
+    std::string wire = base::StringPrintf(
+        "{\"version\":1,\"token\":\"%s\",\"pid\":%d,\"ts\":%lld,",
+        token_.c_str(), static_cast<int>(base::GetCurrentProcId()),
+        static_cast<long long>(
+            base::TimeTicks::Now().since_origin().InMicroseconds()));
+    // Oversized/unsupported frames must not silently leave an apparently
+    // current frame visible. Send an explicit error instead of pixels.
+    if (snapshot.size() > 8 * 1024 * 1024 - 1024) {
+      wire += "\"error\":\"frame-too-large\"}\n";
+    } else {
+      wire += "\"snapshot\":";
+      wire += snapshot;
+      wire += "}\n";
+    }
+    base::AutoLock lock(lock_);
+    latest_ = std::move(wire);
+    if (!scheduled_) {
+      scheduled_ = true;
+      writer_->PostTask(FROM_HERE, base::BindOnce(&RemotePaintStream::Drain,
+                                                base::Unretained(this)));
+    }
+  }
+
+ private:
+  bool WaitWritable(base::TimeTicks deadline) {
+    while (base::TimeTicks::Now() < deadline) {
+      pollfd descriptor{socket_.get(), POLLOUT, 0};
+      int timeout = static_cast<int>(
+          (deadline - base::TimeTicks::Now()).InMilliseconds());
+      int result = poll(&descriptor, 1, std::max(1, timeout));
+      if (result < 0 && errno == EINTR) {
+        continue;
+      }
+      return result > 0 && (descriptor.revents & POLLOUT) &&
+             !(descriptor.revents & (POLLERR | POLLHUP | POLLNVAL));
+    }
+    return false;
+  }
+
+  bool Connect() {
+    socket_.reset(socket(AF_UNIX, SOCK_STREAM, 0));
+    if (!socket_.is_valid() ||
+        fcntl(socket_.get(), F_SETFD, FD_CLOEXEC) < 0 ||
+        fcntl(socket_.get(), F_SETFL, O_NONBLOCK) < 0) {
+      return false;
+    }
+#if BUILDFLAG(IS_APPLE)
+    int no_sigpipe = 1;
+    if (setsockopt(socket_.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe,
+                   sizeof(no_sigpipe)) < 0) {
+      return false;
+    }
+#endif
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    base::span(address.sun_path).copy_prefix_from(base::span(path_));
+    if (connect(socket_.get(), reinterpret_cast<sockaddr*>(&address),
+                sizeof(address)) == 0) {
+      return true;
+    }
+    if (errno != EINPROGRESS ||
+        !WaitWritable(base::TimeTicks::Now() + base::Seconds(1))) {
+      return false;
+    }
+    int error = 0;
+    socklen_t length = sizeof(error);
+    return getsockopt(socket_.get(), SOL_SOCKET, SO_ERROR, &error, &length) == 0 &&
+           error == 0;
+  }
+
+  bool Write(const std::string& message) {
+    if (!socket_.is_valid() && !Connect()) {
+      return false;
+    }
+    const auto deadline = base::TimeTicks::Now() + base::Seconds(1);
+    size_t offset = 0;
+    while (offset < message.size()) {
+      if (base::TimeTicks::Now() >= deadline) {
+        return false;
+      }
+#if BUILDFLAG(IS_APPLE)
+      constexpr int flags = 0;
+#else
+      constexpr int flags = MSG_NOSIGNAL;
+#endif
+      auto remaining = base::as_byte_span(message).subspan(offset);
+      ssize_t count = send(socket_.get(), remaining.data(), remaining.size(),
+                           flags);
+      if (count > 0) {
+        offset += static_cast<size_t>(count);
+      } else if (count < 0 && errno == EINTR) {
+        continue;
+      } else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) &&
+                 WaitWritable(deadline)) {
+        continue;
+      } else {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void Drain() {
+    std::string message;
+    {
+      base::AutoLock lock(lock_);
+      message = std::move(*latest_);
+      latest_.reset();
+    }
+    if (!DisplayItemList::WriteRemoteFontAssets()) {
+      message = base::StringPrintf(
+          "{\"version\":1,\"token\":\"%s\",\"pid\":%d,\"ts\":%lld,"
+          "\"error\":\"font-export-failed\"}\n",
+          token_.c_str(), static_cast<int>(base::GetCurrentProcId()),
+          static_cast<long long>(
+              base::TimeTicks::Now().since_origin().InMicroseconds()));
+    }
+    bool success = Write(message);
+    if (!success) {
+      socket_.reset();  // A partial message is discarded with this connection.
+    }
+    base::AutoLock lock(lock_);
+    if (!success && !latest_) {
+      latest_ = std::move(message);
+    }
+    if (latest_) {
+      writer_->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&RemotePaintStream::Drain, base::Unretained(this)),
+          success ? base::TimeDelta() : base::Milliseconds(100));
+    } else {
+      scheduled_ = false;
+    }
+  }
+
+  std::string path_;
+  std::string token_;
+  scoped_refptr<base::SequencedTaskRunner> writer_;
+  base::Lock lock_;
+  std::optional<std::string> latest_ GUARDED_BY(lock_);
+  bool scheduled_ GUARDED_BY(lock_) = false;
+  base::ScopedFD socket_;  // Accessed only by the sequenced writer.
+};
+#endif

+// Remote SKPs carry exact font references, never font programs. A private
+// per-browser directory owns immutable binary assets; the transport authorizes
+// them per session. Only small instance descriptors remain in this cache.
+struct RemoteFontContext {
+  bool failed = false;
+  std::map<std::string, size_t> fonts;
+  std::map<SkTypefaceID, std::set<SkGlyphID>> glyphs;
+};
+
+class RemoteGlyphCollector : public SkNoDrawCanvas {
+ public:
+  explicit RemoteGlyphCollector(RemoteFontContext* context)
+      : SkNoDrawCanvas(SkIRect::MakeLTRB(-1048576, -1048576, 1048576, 1048576)),
+        context_(context) {}
+ protected:
+  void onDrawTextBlob(const SkTextBlob* blob, SkScalar, SkScalar,
+                      const SkPaint&) override {
+    SkTextBlob::Iter iterator(*blob);
+    SkTextBlob::Iter::Run run;
+    while (iterator.next(&run)) {
+      auto& glyphs = context_->glyphs[run.fTypeface->uniqueID()];
+      // SkTextBlob's iterator guarantees fGlyphCount owned glyph IDs.
+      const auto indices = UNSAFE_BUFFERS(base::span(
+          run.fGlyphIndices, static_cast<size_t>(run.fGlyphCount)));
+      glyphs.insert(indices.begin(), indices.end());
+    }
+  }
+  void onDrawPicture(const SkPicture* picture, const SkMatrix* matrix,
+                     const SkPaint* paint) override {
+    SkCanvas::onDrawPicture(picture, matrix, paint);
+  }
+ private:
+  raw_ptr<RemoteFontContext> context_;
+};
+
+sk_sp<SkData> RemoteOutlineFont(SkTypeface* face,
+                               const std::set<SkGlyphID>& glyphs,
+                               SkFontDescriptor* descriptor) {
+  if (glyphs.empty() || glyphs.size() > 4096) return nullptr;
+  // hvgl is an Apple-specific outline table, unreadable by FreeType. Bake
+  // only used glyph outlines from the native typeface, preserving their IDs.
+  auto description = face->serialize(SkTypeface::SerializeBehavior::kDontIncludeData);
+  if (!description) return nullptr;
+  SkMemoryStream input(description);
+  if (!SkFontDescriptor::Deserialize(&input, descriptor, nullptr) ||
+      descriptor->hasStream()) return nullptr;
+  const int axes = face->getVariationDesignPosition({});
+  if (axes > 16) return nullptr;
+  if (axes > 0) {
+    auto* coordinates = descriptor->setVariationCoordinates(axes);
+    // The descriptor allocates exactly axes coordinates for this Skia API.
+    auto position = UNSAFE_BUFFERS(SkSpan(coordinates, static_cast<size_t>(axes)));
+    if (face->getVariationDesignPosition(position) != axes) return nullptr;
+  }
+  SkDynamicMemoryWStream instance;
+  if (!descriptor->serialize(&instance) || instance.bytesWritten() > 16384) return nullptr;
+  auto arguments = instance.detachAsData();
+  SkDynamicMemoryWStream output;
+  output.write("vdglyph1", 8);
+  output.write32(arguments->size());
+  output.write(arguments->data(), arguments->size());
+  SkFont font(sk_ref_sp(face), 64);
+  font.setHinting(SkFontHinting::kNone);
+  font.setLinearMetrics(true);
+  font.setSubpixel(true);
+  SkFontMetrics metrics{};
+  font.getMetrics(&metrics);
+  output.write32(metrics.fFlags);
+  for (SkScalar value : {metrics.fTop, metrics.fAscent, metrics.fDescent,
+        metrics.fBottom, metrics.fLeading, metrics.fAvgCharWidth,
+        metrics.fMaxCharWidth, metrics.fXMin, metrics.fXMax, metrics.fXHeight,
+        metrics.fCapHeight, metrics.fUnderlineThickness, metrics.fUnderlinePosition,
+        metrics.fStrikeoutThickness, metrics.fStrikeoutPosition}) {
+    output.writeScalar(value / 64);
+  }
+  output.write32(glyphs.size());
+  for (SkGlyphID glyph : glyphs) {
+    auto path = font.getPath(glyph);
+    if (!path && !font.getBounds(glyph, nullptr).isEmpty()) return nullptr;
+    SkPath normalized = path.value_or(SkPath()).makeScale(1.0f / 64, 1.0f / 64);
+    if (!normalized.isFinite()) return nullptr;
+    auto data = normalized.serialize();
+    if (!data || data->size() > 1024 * 1024) return nullptr;
+    output.write32(glyph);
+    output.writeScalar(font.getWidth(glyph) / 64);
+    output.write32(data->size());
+    output.write(data->data(), data->size());
+    if (output.bytesWritten() > 64 * 1024 * 1024) return nullptr;
+  }
+  return output.detachAsData();
+}
+
+class RemoteFontCache {
+ public:
+  sk_sp<const SkData> Serialize(SkTypeface* face, RemoteFontContext* context) {
+    auto directory = base::Environment::Create()->GetVar(
+        "VIRTUAL_DESKTOP_REMOTE_FONT_DIRECTORY");
+    if (!directory || !base::FilePath(*directory).IsAbsolute()) {
+      context->failed = true;
+      return SkData::MakeEmpty();  // Never fall through to embedded serialization.
+    }
+    base::AutoLock lock(lock_);
+    const auto key = std::make_pair(*directory, face->uniqueID());
+    auto found = instances_.find(key);
+    bool outlines = found != instances_.end() && !found->second.glyphs.empty();
+    if (found == instances_.end()) {
+      // Inspect table tags without opening/copying the large hvgl table.
+      const int count = face->countTables();
+      if (count > 0 && count <= 256) {
+        std::vector<SkFontTableTag> tags(count);
+        if (face->readTableTags(SkSpan(tags)) == count) {
+          outlines = std::find(tags.begin(), tags.end(), SkSetFourByteTag('h','v','g','l')) != tags.end();
+        }
+      }
+      outlines |= base::Environment::Create()->GetVar("VIRTUAL_DESKTOP_TEST_OUTLINE_FONTS") == "1";
+    }
+    std::set<SkGlyphID> glyphs;
+    if (outlines) glyphs = context->glyphs[face->uniqueID()];
+    if (found != instances_.end()) {
+      if (!outlines || std::includes(found->second.glyphs.begin(), found->second.glyphs.end(),
+                                    glyphs.begin(), glyphs.end())) {
+        context->fonts[found->second.id] = found->second.bytes;
+        return found->second.reference;
+      }
+      glyphs.insert(found->second.glyphs.begin(), found->second.glyphs.end());
+    }
+    auto fail = [&]() -> sk_sp<const SkData> {
+      context->failed = true;
+      return SkData::MakeEmpty();
+    };
+    if (instances_.size() >= 1024) return fail();
+    SkFontDescriptor descriptor;
+    sk_sp<SkData> data;
+    if (outlines) {
+      data = RemoteOutlineFont(face, glyphs, &descriptor);
+    } else {
+      // Preserve collection index, axes, palette and synthetic style for
+      // portable SFNT fonts. Only this first export opens the full program.
+      auto serialized = face->serialize(SkTypeface::SerializeBehavior::kDoIncludeData);
+      if (!serialized || serialized->size() > 64 * 1024 * 1024) return fail();
+      SkMemoryStream input(serialized);
+      if (!SkFontDescriptor::Deserialize(&input, &descriptor, nullptr) ||
+          !descriptor.hasStream()) return fail();
+      auto font = descriptor.detachStream();
+      data = SkData::MakeFromStream(font.get(), font->getLength());
+    }
+    if (!data || data->size() < 12 || data->size() > 64 * 1024 * 1024)
+      return fail();
+    const std::string id = base::HexEncodeLower(crypto::hash::Sha256(
+        skia::as_byte_span(*data)));
+    const auto asset_key = std::make_pair(*directory, id);
+    if (!assets_.contains(asset_key)) {
+      if (asset_bytes_ + data->size() > 128 * 1024 * 1024) return fail();
+      // Only enqueue on the impl thread. The MayBlock stream writer flushes
+      // these immutable binary assets before publishing any dependent frame.
+      pending_[asset_key] = data;
+      assets_[asset_key] = data->size();
+      asset_bytes_ += data->size();
+    }
+    SkDynamicMemoryWStream instance;
+    if (!descriptor.serialize(&instance) || instance.bytesWritten() > 16 * 1024)
+      return fail();
+    auto arguments = instance.detachAsData();
+    SkDynamicMemoryWStream reference;
+    reference.write("vdfont01", 8);
+    reference.write(id.data(), id.size());
+    reference.write32(arguments->size());
+    reference.write(arguments->data(), arguments->size());
+    auto result = reference.detachAsData();
+    instances_[key] = {id, data->size(), result, std::move(glyphs)};
+    context->fonts[id] = data->size();
+    return result;
+  }
+
+  bool WritePending() {
+    std::map<std::pair<std::string, std::string>, sk_sp<SkData>> pending;
+    {
+      base::AutoLock lock(lock_);
+      if (write_failed_) return false;
+      pending.swap(pending_);
+    }
+    bool success = true;
+    for (const auto& [key, data] : pending) {
+      base::FilePath temporary;
+      const base::FilePath parent(key.first);
+      if (!base::CreateTemporaryFileInDir(parent, &temporary)) {
+        success = false;
+        continue;
+      }
+      const bool written = base::WriteFile(temporary, skia::as_byte_span(*data));
+      if (!written || !base::Move(temporary, parent.AppendASCII(key.second + ".font"))) {
+        base::DeleteFile(temporary);
+        success = false;
+      }
+    }
+    base::AutoLock lock(lock_);
+    write_failed_ |= !success;
+    return !write_failed_;
+  }
+
+ private:
+  struct Instance { std::string id; size_t bytes; sk_sp<const SkData> reference; std::set<SkGlyphID> glyphs; };
+  base::Lock lock_;
+  size_t asset_bytes_ = 0;
+  bool write_failed_ = false;
+  std::map<std::pair<std::string, std::string>, sk_sp<SkData>> pending_;
+  std::map<std::pair<std::string, SkTypefaceID>, Instance> instances_;
+  std::map<std::pair<std::string, std::string>, size_t> assets_;
+};
+
+RemoteFontCache& RemoteFonts() {
+  static base::NoDestructor<RemoteFontCache> cache;
+  return *cache;
+}
+
+void SerializeRemotePicture(SkPicture* picture,
+                            base::trace_event::TracedValue* state) {
+  RemoteFontContext context;
+  RemoteGlyphCollector collector(&context);
+  picture->playback(&collector);
+  SkSerialProcs procs;
+  procs.fTypefaceCtx = &context;
+  procs.fTypefaceProc = [](SkTypeface* face, void* ctx) -> sk_sp<const SkData> {
+    return RemoteFonts().Serialize(face, static_cast<RemoteFontContext*>(ctx));
+  };
+  auto data = picture->serialize(&procs);
+  state->SetBoolean("font_error", context.failed || !data);
+  state->SetInteger("font_count", context.fonts.size());
+  state->BeginArray("fonts");
+  for (const auto& [id, bytes] : context.fonts) {
+    state->BeginDictionary();
+    state->SetString("id", id);
+    state->SetInteger("bytes", bytes);
+    state->EndDictionary();
+  }
+  state->EndArray();
+  if (!context.failed && data) {
+    state->SetString("skp64", base::Base64Encode(skia::as_byte_span(*data)));
+  }
+}

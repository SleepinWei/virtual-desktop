+void LayerTreeImpl::AsRemotePaintValueInto(
+    base::trace_event::TracedValue* state) {
+  state->SetInteger("version", 1);
+  state->SetInteger("tree_id", host_impl_->id());
+  state->SetInteger("source_frame_number", source_frame_number_);
+  MathUtil::AddToTracedValue("viewport", GetDeviceViewport(), state);
+  state->BeginArray("background");
+  for (float component : {background_color_.fR, background_color_.fG,
+                          background_color_.fB, background_color_.fA}) {
+    state->AppendDouble(component);
+  }
+  state->EndArray();
+  const auto* root = RootRenderSurface();
+  state->SetInteger("root", root ? root->EffectTreeIndex() : -1);
+  std::vector<std::string> unsupported;
+  if (!root) {
+    unsupported.push_back("missing-root-surface");
+  }
+
+  state->BeginArray("surfaces");
+  for (int effect_id : GetRenderSurfaceList()) {
+    const auto* surface = GetRenderSurface(effect_id);
+    state->BeginDictionary();
+    state->SetInteger("id", effect_id);
+    MathUtil::AddToTracedValue("content_rect", surface->content_rect(), state);
+    if (!surface->Filters().IsEmpty() ||
+        !surface->BackdropFilters().IsEmpty() ||
+        !surface->mask_filter_info().IsEmpty() ||
+        surface->BlendMode() != SkBlendMode::kSrcOver ||
+        !surface->draw_transform().Is2dTransform() ||
+        surface->HasMaskingContributingSurface() ||
+        surface->has_view_transition_capture_contributions() ||
+        surface->CopyOfOutputRequired() || surface->IsUnbounded()) {
+      unsupported.push_back("surface-effects");
+    }
+    state->EndDictionary();
+  }
+  state->EndArray();
+  state->SetInteger("surface_count", GetRenderSurfaceList().size());
+
+  // This is the same front-to-back traversal used by CalculateRenderPasses,
+  // before remote picture layers reject WillDraw/AppendQuads. Surface entries
+  // preserve group opacity; multiplying opacity into individual children is
+  // incorrect where children overlap.
+  state->BeginArray("entries");
+  int entry_count = 0;
+  for (EffectTreeLayerListIterator it(this);
+       it.state() != EffectTreeLayerListIterator::State::kEnd; ++it) {
+    if (it.state() == EffectTreeLayerListIterator::State::kTargetSurface) {
+      continue;
+    }
+    state->BeginDictionary();
+    ++entry_count;
+    state->SetInteger("target", it.target_effect_tree_index());
+    if (it.state() ==
+        EffectTreeLayerListIterator::State::kContributingSurface) {
+      const auto* surface = it.current_render_surface();
+      state->SetString("kind", "surface");
+      state->SetInteger("id", surface->EffectTreeIndex());
+      MathUtil::AddToTracedValue("transform", surface->draw_transform(), state);
+      state->SetDouble("opacity", surface->draw_opacity());
+      state->SetBoolean("is_clipped", surface->is_clipped());
+      MathUtil::AddToTracedValue("clip", surface->clip_rect(), state);
+    } else {
+      const auto* layer = it.current_layer();
+      state->SetInteger("id", layer->id());
+      MathUtil::AddToTracedValue("bounds", gfx::Rect(layer->bounds()), state);
+      MathUtil::AddToTracedValue("transform", layer->DrawTransform(), state);
+      state->SetDouble("opacity", layer->draw_opacity());
+      state->SetBoolean("is_clipped", layer->is_clipped());
+      MathUtil::AddToTracedValue("clip", layer->clip_rect(), state);
+      const auto& effect = property_trees()->effect_tree().Node(
+          layer->effect_tree_index());
+      if (!layer->DrawTransform().Is2dTransform() || layer->Is3dSorted() ||
+          !layer->draw_properties().mask_filter_info.IsEmpty() ||
+          (!effect.HasRenderSurface() &&
+           effect.blend_mode != SkBlendMode::kSrcOver)) {
+        unsupported.push_back("layer-effects");
+      }
+      if (layer->GetLayerType() == mojom::LayerType::kPicture) {
+        state->SetString("kind", "picture");
+        const auto* picture = static_cast<const PictureLayerImpl*>(layer);
+        const auto* source = picture->GetRasterSource();
+        const auto* list = source ? source->GetDisplayItemList().get() : nullptr;
+        if (list && !list->has_discardable_images()) {
+          const auto offsets = picture->GetRasterInducingScrollOffsets();
+          state->BeginDictionary("record");
+          list->AsRemotePaintValueInto(state, offsets);
+          state->EndDictionary();
+        } else {
+          unsupported.push_back("picture-images-or-missing-record");
+        }
+      } else if (layer->GetLayerType() == mojom::LayerType::kSolidColor) {
+        state->SetString("kind", "solid");
+        const auto color = layer->background_color();
+        state->BeginArray("color");
+        for (float component : {color.fR, color.fG, color.fB, color.fA}) {
+          state->AppendDouble(component);
+        }
+        state->EndArray();
+      } else {
+        state->SetString("kind", "unsupported");
+        unsupported.push_back("non-picture-layer");
+      }
+    }
+    state->EndDictionary();
+  }
+  state->EndArray();
+  state->SetInteger("entry_count", entry_count);
+  state->BeginArray("scroll_offsets");
+  int scroll_count = 0;
+  const auto& scroll_tree = property_trees()->scroll_tree();
+  for (const auto& node : scroll_tree.nodes()) {
+    if (!node.element_id) {
+      continue;
+    }
+    state->BeginDictionary();
+    ++scroll_count;
+    state->SetString("id", node.element_id.ToString());
+    MathUtil::AddToTracedValue(
+        "offset", scroll_tree.current_scroll_offset(node.element_id), state);
+    state->EndDictionary();
+  }
+  state->EndArray();
+  state->SetInteger("scroll_count", scroll_count);
+  state->BeginArray("unsupported");
+  for (const auto& reason : unsupported) {
+    state->AppendString(reason);
+  }
+  state->EndArray();
+  state->SetInteger("unsupported_count", unsupported.size());
+  state->SetBoolean("supported", unsupported.empty());
+}

@@ -330,6 +330,53 @@ class PictureLayerImplTest : public TestLayerTreeHostBase {
   void TestQuadsForSolidColor(bool test_for_solid, bool partial_opaque);
 };
 
+class RemotePaintPictureLayerImplTest : public PictureLayerImplTest {
+ public:
+  LayerTreeSettings CreateSettings() override {
+    auto settings = PictureLayerImplTest::CreateSettings();
+    settings.remote_paint_only = true;
+    return settings;
+  }
+};
+
+TEST_F(RemotePaintPictureLayerImplTest, PreservesRecordingWithoutTilings) {
+  SetupDefaultTrees(gfx::Size(128, 128));
+  for (auto* layer : {active_layer(), pending_layer()}) {
+    ASSERT_TRUE(layer->GetRasterSource());
+    EXPECT_TRUE(layer->GetRasterSource()->HasRecordings());
+    EXPECT_FALSE(layer->CanHaveTilings());
+    EXPECT_FALSE(layer->UpdateTiles());
+    EXPECT_EQ(0u, layer->num_tilings());
+    EXPECT_EQ(0u, layer->GPUMemoryUsageInBytes());
+  }
+}
+
+TEST_F(RemotePaintPictureLayerImplTest, ActivatesSuccessiveRecordings) {
+  SetupDefaultTrees(gfx::Size(128, 128));
+  ActivateTree();
+  for (int i = 0; i < 3; ++i) {
+    auto source = FakeRasterSource::CreateFilled(gfx::Size(128 + i, 128));
+    SetupPendingTreeWithInvalidation(source, Region(gfx::Rect(source->size())));
+    EXPECT_EQ(0u, pending_layer()->num_tilings());
+    ActivateTree();
+    EXPECT_EQ(source.get(), active_layer()->GetRasterSource());
+    EXPECT_EQ(0u, active_layer()->num_tilings());
+  }
+}
+
+TEST_F(RemotePaintPictureLayerImplTest, RejectsEveryPictureDrawBackend) {
+  SetupDefaultTrees(gfx::Size(128, 128));
+  for (auto mode : {DRAW_MODE_HARDWARE, DRAW_MODE_SOFTWARE,
+                    DRAW_MODE_RESOURCELESS_SOFTWARE}) {
+    EXPECT_FALSE(active_layer()->WillDraw(mode, nullptr));
+    auto render_pass = viz::CompositorRenderPass::Create();
+    AppendQuadsData data;
+    active_layer()->AppendQuads(AppendQuadsContext{mode, {}, false},
+                                render_pass.get(), &data);
+    EXPECT_TRUE(render_pass->quad_list.empty());
+  }
+}

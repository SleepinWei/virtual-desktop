+class RemoteGlyphVerifier : public SkNoDrawCanvas {
+public:
+    explicit RemoteGlyphVerifier(const std::map<SkTypefaceID, std::set<SkGlyphID>>& glyphs)
+        : SkNoDrawCanvas(SkIRect::MakeLTRB(-1048576, -1048576, 1048576, 1048576)), fGlyphs(glyphs) {}
+    bool failed = false;
+protected:
+    void onDrawTextBlob(const SkTextBlob* blob, SkScalar, SkScalar, const SkPaint&) override {
+        SkTextBlob::Iter iterator(*blob);
+        SkTextBlob::Iter::Run run;
+        while (iterator.next(&run)) {
+            auto found = fGlyphs.find(run.fTypeface->uniqueID());
+            if (found == fGlyphs.end()) continue;
+            for (int i = 0; i < run.fGlyphCount; ++i) {
+                if (!found->second.count(run.fGlyphIndices[i])) failed = true;
+            }
+        }
+    }
+    void onDrawPicture(const SkPicture* picture, const SkMatrix* matrix, const SkPaint* paint) override {
+        SkCanvas::onDrawPicture(picture, matrix, paint);
+    }
+private:
+    const std::map<SkTypefaceID, std::set<SkGlyphID>>& fGlyphs;
+};

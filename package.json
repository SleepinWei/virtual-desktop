{
  "name": "virtual-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent session and client-side drawing protocol proof of concept",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:native": "node experiments/chromium-engine/live.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "bench": "node scripts/benchmark.js",
    "demo:agent": "node scripts/agent-demo.js",
    "check": "node scripts/check.js && npm run test:engine-build",
    "experiment:paint": "node experiments/chromium-paint/run.js",
    "experiment:replay": "node experiments/chromium-paint/verify-saved.js",
    "experiment:headless": "node experiments/chromium-paint/run.js --headless-probe --output test-results/chromium-headless",
    "experiment:engine": "node experiments/chromium-engine/run.js",
    "experiment:frames": "node experiments/chromium-engine/run-frames.js",
    "experiment:live": "node experiments/chromium-engine/run-live.js",
    "bench:native": "node experiments/chromium-engine/benchmark.js",
    "experiment:site": "node experiments/chromium-engine/probe-site.js",
    "package:native": "node experiments/chromium-engine/package-runtime.js",
    "test:native-package": "node experiments/chromium-engine/smoke-runtime.js",
    "test:engine-build": "python3 -B -m unittest discover -s experiments/chromium-engine -p '*_test.py'"
  },
  "dependencies": {
    "linkedom": "0.18.14",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "canvaskit-wasm": "0.42.0",
    "playwright": "1.64.1"
  }
}
